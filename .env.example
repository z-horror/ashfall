# ==============================================================================
# ASHFALL — Configuration Template
# ==============================================================================

# --- Domain & TLS (Caddy Reverse Proxy) ---
# Set your domain for automatic HTTPS via Let's Encrypt (e.g., ashfall.example.com).
# If not yet pointed or using IP/localhost, leave as localhost or VPS IP.
APP_DOMAIN=localhost

# --- Core Server ---
NODE_ENV=production
PORT=3000

# --- PostgreSQL Database ---
# In Docker Compose, the server connects via internal hostname 'db:5432'.
POSTGRES_DB=ashfall
POSTGRES_USER=ashfall
POSTGRES_PASSWORD=change_this_to_a_secure_random_password
DATABASE_URL=postgres://ashfall:change_this_to_a_secure_random_password@db:5432/ashfall
MIGRATE_ON_START=true

# --- Closed Beta & Moderation ---
# Require valid invite code for new user registration (true/false)
REQUIRE_INVITES=true
# Allow guest login without invite code (false recommended for closed beta)
ALLOW_GUEST_LOGIN=false
# Admin panel password (used to log in at /admin)
ADMIN_PASSWORD=change_this_to_a_strong_admin_password

# --- World Simulation ---
# Deterministic world seed. Change only when you want a completely fresh city map.
WORLD_SEED=greywater-01
TICK_HZ=20
SNAPSHOT_HZ=12
AOI_RADIUS=28
CHUNK_RADIUS=1

# --- Sessions & Network Security ---
SESSION_TTL_HOURS=168
MAX_MESSAGE_BYTES=16384
MAX_MESSAGES_PER_SEC=90

# --- Developer Privileges (MUST BE FALSE IN PRODUCTION) ---
TEST_COMBAT_BUFFS=false
ALLOW_DEV_ACTIONS=false
ADMIN_USERS=

# --- Core ---
NODE_ENV=development
# Game HTTP/WebSocket port (server). Client dev server uses Vite on 5173.
PORT=3000

# --- PostgreSQL ---
# Local development uses the docker compose database (host port 5433).
DATABASE_URL=postgres://ashfall:ashfall@127.0.0.1:5433/ashfall
POSTGRES_DB=ashfall
POSTGRES_USER=ashfall
POSTGRES_PASSWORD=ashfall
# Run SQL migrations on server boot.
MIGRATE_ON_START=true

# --- World / simulation ---
# Deterministic world seed. Change only for a fresh world (delete world_chunks or DB volume).
WORLD_SEED=greywater-01
TICK_HZ=20
SNAPSHOT_HZ=12
# Interest management radius in tiles.
AOI_RADIUS=28
# Chunk load radius (chunks).
CHUNK_RADIUS=1

# --- Sessions / security ---
# Session lifetime in hours.
SESSION_TTL_HOURS=168
# Max WebSocket message size in bytes.
MAX_MESSAGE_BYTES=16384
# Max client messages per second (burst).
MAX_MESSAGES_PER_SEC=90

# --- Client (only used at build time by Vite) ---
# Leave empty when the client is served behind the same origin / dev proxy.
VITE_API_BASE=
VITE_WS_URL=
